# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Kunci rahasia untuk menandatangani sesi login penyelenggara. Isi string acak panjang, mis.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (Saat npm run dev tanpa .env, kunci bawaan khusus pengembangan dipakai. Di production WAJIB diisi.)
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Lokasi file data akun penyelenggara, peserta & pemenang (opsional). Default: ./data  (di Docker: /app/data)
# DATA_DIR=./data
